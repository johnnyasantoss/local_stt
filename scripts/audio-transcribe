#!/usr/bin/env python3
"""Transcribe audio files using Groq Whisper API and output merged SRT."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))

from src.config import require_env
from src.logging import add_verbose_arg, setup_logging
from src.transcribe import (
    MAX_FILE_SIZE_MB,
    TranscriptionError,
    transcribe_audio,
)


def main() -> int:
    import argparse
    
    parser = argparse.ArgumentParser(
        description="Transcribe audio using Groq Whisper API"
    )
    add_verbose_arg(parser)
    parser.add_argument("-i", "--input", type=Path, required=True,
                        help="Input audio file or directory of chunks")
    parser.add_argument("-o", "--output", type=Path, required=True,
                        help="Output .srt file")
    parser.add_argument("-m", "--model", default="whisper-large-v3-turbo",
                        help=f"Whisper model (default: whisper-large-v3-turbo)")
    parser.add_argument("-l", "--language",
                        help="Language code (e.g., en)")
    parser.add_argument("-j", "--parallel", type=int, default=4,
                        help="Parallel API calls (default: 4)")
    parser.add_argument("--overlap-secs", type=float, default=5.0,
                        help="Overlap seconds used when splitting (default: 5)")
    parser.add_argument("--chunk-duration", type=float, default=600.0,
                        help="Chunk duration in seconds (default: 600)")
    
    args = parser.parse_args()
    logger = setup_logging(args.v)
    
    require_env("GROQ_API_KEY")
    
    input_path = args.input
    if not input_path.exists():
        logger.error(f"Input not found: {input_path}")
        return 1
    
    if input_path.is_file():
        size_mb = input_path.stat().st_size / (1024 * 1024)
        if size_mb > MAX_FILE_SIZE_MB:
            logger.error(
                f"File size ({size_mb:.1f}MB) exceeds {MAX_FILE_SIZE_MB}MB limit. "
                "Use audio-split first, then pass the directory."
            )
            return 1
    
    try:
        output_path = transcribe_audio(
            input_path=input_path,
            output_path=args.output,
            model=args.model,
            language=args.language,
            parallel=args.parallel,
            overlap_secs=args.overlap_secs,
            chunk_duration=args.chunk_duration,
            logger=logger,
        )
        print(str(output_path))
        return 0
    
    except TranscriptionError as e:
        logger.error(f"Transcription error: {e}")
        return 1
    except Exception as e:
        logger.error(f"Error: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())