#!/usr/bin/env python3
"""Audio loudness normalization using EBU R128."""

import argparse
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))

from src.audio import load_audio, get_audio_info, detect_format
from src.logging import setup_logging, add_verbose_arg


def normalize_loudness(
    input_path: Path,
    output_path: Path,
    target_lufs: float = -16.0,
    logger=None,
) -> None:
    """Apply EBU R128 loudness normalization using ffmpeg."""
    cmd = [
        "ffmpeg",
        "-hide_banner",
        "-loglevel", "warning",
        "-i", str(input_path),
        "-af", f"loudnorm=I={target_lufs}:TP=-1.5:LRA=11",
        "-y",
        str(output_path),
    ]
    subprocess.run(cmd, check=True)


def main() -> int:
    parser = argparse.ArgumentParser(description="Normalize audio loudness (EBU R128)")
    add_verbose_arg(parser)
    parser.add_argument("-i", "--input", type=Path, required=True, help="Input audio file")
    parser.add_argument("-o", "--output", type=Path, help="Output file (default: stdout)")
    parser.add_argument(
        "--target-lufs", type=float, default=-16.0, help="Target loudness in LUFS (default: -16)"
    )

    args = parser.parse_args()
    logger = setup_logging(args.v)

    try:
        input_path = args.input
        logger.info(f"Loading: {input_path}")

        audio = load_audio(input_path)
        info = get_audio_info(audio)
        logger.info(f"Audio: {info['duration_seconds']:.1f}s, {info['channels']}ch, {info['sample_rate']}Hz")

        with tempfile.TemporaryDirectory() as tmpdir:
            tmp_path = Path(tmpdir) / "normalized.wav"
            logger.info(f"Normalizing to {args.target_lufs} LUFS...")
            normalize_loudness(input_path, tmp_path, args.target_lufs, logger)

            if args.output:
                output_path = args.output
                output_path.parent.mkdir(parents=True, exist_ok=True)
                tmp_path.rename(output_path)
                print(str(output_path))
            else:
                # For stdout, just print the temp path
                print(str(tmp_path))

        logger.info("Done")
        return 0

    except FileNotFoundError as e:
        logger.error(f"File not found: {e}")
        return 1
    except subprocess.CalledProcessError as e:
        logger.error(f"FFmpeg error: {e}")
        return 1
    except Exception as e:
        logger.error(f"Error: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
