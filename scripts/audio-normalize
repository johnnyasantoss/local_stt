#!/usr/bin/env python3
"""Audio loudness normalization using EBU R128."""

import argparse
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))

from src.audio import get_audio_info, load_audio
from src.config import resolve_output_path
from src.logging import add_verbose_arg, setup_logging


def get_default_threads() -> int:
    """Return default thread count (0 = all cores)."""
    return 0


def normalize_loudness(
    input_path: Path,
    output_path: Path,
    target_lufs: float = -16.0,
    threads: int = 0,
    logger=None,
) -> None:
    """Apply EBU R128 loudness normalization using ffmpeg."""
    cmd = [
        "ffmpeg",
        "-hide_banner",
        "-loglevel", "warning",
        "-threads", str(threads) if threads > 0 else str(os.cpu_count() or 1),
        "-i", str(input_path),
        "-af", f"loudnorm=I={target_lufs}:TP=-1.5:LRA=11",
        "-y",
        str(output_path),
    ]
    subprocess.run(cmd, check=True)


def main() -> int:
    parser = argparse.ArgumentParser(description="Normalize audio loudness (EBU R128)")
    add_verbose_arg(parser)
    parser.add_argument("-i", "--input", type=Path, required=True, help="Input audio file")
    parser.add_argument("-o", "--output", type=Path, help="Output file (default: stdout)")
    parser.add_argument(
        "--target-lufs", type=float, default=-16.0, help="Target loudness in LUFS (default: -16)"
    )
    parser.add_argument(
        "-j", "--threads", type=int, default=0,
        help="Number of threads (0 = all cores, default: 0)"
    )

    args = parser.parse_args()
    logger = setup_logging(args.v)

    try:
        input_path = args.input
        logger.info(f"Loading: {input_path}")

        audio = load_audio(input_path)
        info = get_audio_info(audio)
        logger.info(f"Audio: {info['duration_seconds']:.1f}s, {info['channels']}ch, {info['sample_rate']}Hz")

        output_path = resolve_output_path(args.output, input_path, "wav")
        output_path.parent.mkdir(parents=True, exist_ok=True)

        logger.info(f"Normalizing to {args.target_lufs} LUFS (threads: {args.threads or 'all'})...")
        normalize_loudness(input_path, output_path, args.target_lufs, args.threads, logger)

        logger.info(f"Done: {output_path}")
        print(str(output_path))
        return 0

    except FileNotFoundError as e:
        logger.error(f"File not found: {e}")
        return 1
    except subprocess.CalledProcessError as e:
        logger.error(f"FFmpeg error: {e}")
        return 1
    except Exception as e:
        logger.error(f"Error: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
