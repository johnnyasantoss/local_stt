#!/usr/bin/env python3
"""Full audio processing pipeline: normalize -> enhance -> convert -> split -> transcribe.

Intermediate files are cached in <output>/intermediates/ and reused on re-runs.
A stage is skipped if its output file already exists (use --force to re-run all).
"""

import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))

from src.audio import numeric_sort_key
from src.config import load_env
from src.diarize import load_speaker_mapping
from src.local_transcribe import model_audio_window_seconds, resolve_model
from src.logging import setup_logging


def _effective_max_seconds(args) -> float | None:
    """Resolve the per-model chunk cap that will be applied at split time."""
    if args.engine != "local":
        return None
    try:
        return model_audio_window_seconds(resolve_model(args.model))
    except Exception:
        return None


def _split_meta_matches(meta_path: Path, size_mb: float, overlap: int, max_seconds: float | None) -> bool:
    """True if the cached split parameters match the current request."""
    try:
        meta = json.loads(meta_path.read_text())
    except Exception:
        return False
    if meta.get("size_mb") != size_mb or meta.get("overlap") != overlap:
        return False
    return meta.get("max_seconds") == max_seconds

def run_script(script: str, args: list, logger, threads: int = 0) -> subprocess.CompletedProcess:
    """Run a script, streaming stdout/stderr to the pipeline log in real-time.

    Returns a CompletedProcess with captured stdout (for scripts that print output paths).
    """
    if threads > 0:
        args = ["-j", str(threads)] + args
    cmd = ["python", f"scripts/{script}"] + args
    logger.debug(f"Running: {' '.join(cmd)}")

    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )

    captured_lines = []
    for line in proc.stdout:
        line = line.rstrip()
        # Print child output so it appears in the pipeline log immediately
        print(line, flush=True)
        captured_lines.append(line)

    proc.wait()
    stdout = "\n".join(captured_lines)
    return subprocess.CompletedProcess(args=cmd, returncode=proc.returncode, stdout=stdout)


def validate_args(args, logger) -> bool:
    """Validate flag combinations before any pipeline work starts.

    Returns True if valid, False otherwise (errors are logged to stderr).
    """
    valid = True

    # --num-speakers requires --diarize
    if args.num_speakers is not None and not args.diarize:
        logger.error("--num-speakers has no effect without --diarize")
        valid = False

    # Engine-specific checks
    if args.engine == "groq":
        load_env()
        import os

        if not os.getenv("GROQ_API_KEY"):
            logger.error("--engine groq requires GROQ_API_KEY. Set it in .env or export it.")
            valid = False

    if args.engine == "local":
        # Validate transcribe-cli binary + GGUF model early (fail fast).
        from src.local_transcribe import resolve_cli, resolve_model

        try:
            resolve_cli()
            resolve_model(args.model)
        except (FileNotFoundError, ValueError) as e:
            logger.error(str(e))
            valid = False

        # HF_TOKEN required if diarize requested
        if args.diarize:
            load_env()
            import os

            if not os.getenv("HF_TOKEN"):
                logger.error(
                    "--diarize requires HF_TOKEN. "
                    "Set it in .env with a HuggingFace token that has "
                    "accepted pyannote/speaker-diarization-3.1 conditions."
                )
                valid = False

    return valid


def main() -> int:
    epilog = """\
examples:
  # Basic transcription via Groq cloud
  audio-process -i recording.m4a -o ./out

  # Resume a crashed run
  audio-process -i recording.m4a -o ./out -c

  # Local offline transcription with diarization
  audio-process -i meeting.m4a -o ./out --engine local --diarize --num-speakers 3

  # Force full re-run, clean intermediates after
  audio-process -i recording.m4a -o ./out --force --clean-temp

pipeline stages:
  1. Normalize   - loudness normalization (EBU R128)
  2. Enhance     - voice band isolation (highpass/lowpass)
  3. Convert     - resample to 16kHz mono Opus
  4. Split       - chunk by size with overlap
  5. Transcribe  - Groq cloud or local transcribe.cpp (ggml)
"""

    parser = argparse.ArgumentParser(
        description=(
            "Full audio processing pipeline: normalize -> enhance -> convert -> split -> transcribe.\n"
            "Intermediate files are cached in <output>/intermediates/ and reused on re-runs.\n"
            "A stage is skipped if its output file already exists (use --force to re-run all)."
        ),
        epilog=epilog,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "-v",
        "-vv",
        "-vvv",
        action="count",
        default=0,
        help=(
            "Increase verbosity. Can be stacked: -v for info-level logging, "
            "-vv for debug-level, -vvv for trace-level. Controls both this script's "
            "output and the output of sub-scripts (normalize, enhance, etc.). "
            "(default: 0)"
        ),
    )
    parser.add_argument(
        "-i",
        "--input",
        type=Path,
        required=True,
        help=(
            "Path to the input audio file. Supports common formats including "
            "M4A, MP3, WAV, OGG, FLAC, and Opus. The file is read by ffmpeg for "
            "all processing stages. Must be a readable file on disk."
        ),
    )
    parser.add_argument(
        "-o",
        "--output",
        type=Path,
        required=True,
        help=(
            "Path to the output directory. Created automatically if it does not "
            "exist. If the directory already contains files, the script refuses "
            "to run unless --continue or --force is passed. All output (chunks, "
            "transcription SRT, intermediates) is written here."
        ),
    )
    parser.add_argument(
        "--clean-temp",
        action="store_true",
        default=False,
        help=(
            "Delete intermediate files in <output>/intermediates/ after the "
            "pipeline finishes. By default, normalized, enhanced, and converted "
            "WAV/OGG files are retained for debugging or re-running individual "
            "stages manually. (default: false)"
        ),
    )
    parser.add_argument(
        "--overlap",
        type=int,
        default=2,
        help=(
            "Seconds of overlap between consecutive chunks (default: 2). "
            "Overlap duplicates audio the model re-transcribes; 2s is enough "
            "for cohere/whisper 15-65s windows to not drop mid-boundary words "
            "while cutting redundant transcription versus the old 5s default."
        ),
    )
    parser.add_argument(
        "--size-mb",
        type=float,
        default=10,
        help=(
            "Maximum chunk file size in MiB for the split stage. Audio is split "
            "into chunks no larger than this to stay within transcription API "
            "limits. Smaller chunks give more granular progress but increase the "
            "number of API calls. (default: 10)"
        ),
    )
    parser.add_argument(
        "-j",
        "--threads",
        type=int,
        default=0,
        help=(
            "Number of parallel worker threads for ffmpeg-heavy stages "
            "(normalize, enhance, convert, split). 0 means use all available "
            "CPU cores. Set lower on shared machines or when bandwidth/I/O is "
            "the bottleneck. (default: 0)"
        ),
    )
    parser.add_argument(
        "--engine",
        choices=["groq", "local"],
        default="groq",
        help=(
            "Transcription backend to use. 'groq' sends chunks to the Groq cloud "
            "API (requires GROQ_API_KEY in .env, fast, paid). 'local' runs transcribe.cpp "
            "(Handy Computer's ggml STT) offline via a built binary; default model "
            "whisper-large-v3-turbo. Free. (default: groq)"
        ),
    )
    parser.add_argument(
        "--model",
        default=None,
        help=(
            "Model name for the chosen engine. For --engine groq: any "
            "Groq-supported model (e.g. distil-whisper-large-v3-en, "
            "whisper-large-v3). For --engine local: a GGUF path or HF cache short "
            "name; use "
            "`scripts/audio-transcribe-local --list-models` to list cached handy-computer "
            "GGUFs. Required for --engine local (no default model). For groq it "
            "defaults to the API's default if omitted. "
        ),
    )
    parser.add_argument(
        "--language",
        default=None,
        help=(
            "ISO 639-1 two-letter code (e.g. en, es, fr, pt) hinting the "
            "transcription engine. Regional variants like pt-BR are not supported; "
            "use the base code (pt). Improves accuracy and speed when the language "
            "is known. If omitted, the engine auto-detects the language. "
            "(default: auto-detect)"
        ),
    )
    parser.add_argument(
        "--diarize",
        action="store_true",
        default=False,
        help=(
            "Run speaker diarization after transcription (local engine only, "
            "ignored for Groq). Identifies and labels different speakers in the "
            "audio. Requires HF_TOKEN in .env for pyannote model access. Adds "
            "significant processing time. Results are cached alongside the "
            "transcript. (default: false)"
        ),
    )
    parser.add_argument(
        "--num-speakers",
        type=int,
        default=None,
        help=(
            "Number of distinct speakers expected in the audio (local engine + "
            "diarize only). Helps the diarization model converge faster and more "
            "accurately. If omitted, the model estimates the count automatically. "
            "Has no effect without --diarize. (default: auto-estimate)"
        ),
    )
    parser.add_argument(
        "--force",
        action="store_true",
        default=False,
        help=(
            "Re-run every pipeline stage from scratch, ignoring any cached "
            "intermediate or output files. Equivalent to deleting "
            "<output>/intermediates/ and all chunks before running. Use when you "
            "changed settings and need a clean pass. (default: false)"
        ),
    )
    parser.add_argument(
        "-c",
        "--continue",
        action="store_true",
        dest="continue_run",
        help=(
            "Allow the pipeline to run into an output directory that already "
            "contains files. Without this flag, the script exits with an error "
            "if the output dir is non-empty. Combined with caching, this lets "
            "you resume a failed run without re-computing completed stages. "
            "(default: false)"
        ),
    )

    args = parser.parse_args()
    logger = setup_logging(args.v)

    if not validate_args(args, logger):
        return 1

    try:
        input_path = args.input.resolve()
        output_dir = args.output.resolve()
        output_dir.mkdir(parents=True, exist_ok=True)

        # Safety: refuse to run on non-empty output dir unless --continue or --force
        existing = [p for p in output_dir.iterdir() if p.name != "pipeline.log"]
        if existing and not (args.continue_run or args.force):
            logger.error(
                f"Output dir '{output_dir}' already contains {len(existing)} item(s). "
                "Use --continue/-c to resume, or --force to re-run from scratch."
            )
            return 1

        inter_dir = output_dir / "intermediates"
        inter_dir.mkdir(parents=True, exist_ok=True)

        logger.info("=" * 50)
        logger.info("Starting audio processing pipeline")
        logger.info("=" * 50)

        # Stage 1: Normalize
        norm_out = inter_dir / "normalized.wav"
        if norm_out.exists() and not args.force:
            logger.info(f"[1/5] Normalize: cached ({norm_out.name})")
        else:
            logger.info("[1/5] Normalizing loudness...")
            result = run_script(
                "audio-normalize",
                ["-i", str(input_path), "-o", str(norm_out), "-v" * args.v],
                logger,
                args.threads,
            )
            if result.returncode != 0:
                logger.error(f"normalize failed: {result.stderr}")
                return 1
            logger.info(f"  -> {norm_out}")

        # Stage 2: Enhance
        enh_out = inter_dir / "enhanced.wav"
        if enh_out.exists() and not args.force:
            logger.info(f"[2/5] Enhance: cached ({enh_out.name})")
        else:
            logger.info("[2/5] Enhancing voice...")
            result = run_script(
                "audio-enhance",
                ["-i", str(norm_out), "-o", str(enh_out), "-v" * args.v],
                logger,
                args.threads,
            )
            if result.returncode != 0:
                logger.error(f"enhance failed: {result.stderr}")
                return 1
            logger.info(f"  -> {enh_out}")

        # Stage 3: Convert
        conv_out = output_dir / "processed.ogg"
        if conv_out.exists() and not args.force:
            logger.info(f"[3/5] Convert: cached ({conv_out.name})")
        else:
            logger.info("[3/5] Converting to 16kHz mono Opus...")
            result = run_script(
                "audio-convert",
                ["-i", str(enh_out), "-o", str(conv_out), "-v" * args.v],
                logger,
                args.threads,
            )
            if result.returncode != 0:
                logger.error(f"convert failed: {result.stderr}")
                return 1
            logger.info(f"  -> {conv_out}")

        # Stage 4: Split
        split_dir = output_dir / "chunks"
        split_meta = split_dir / ".split-meta.json"
        split_cached = (
            split_dir.exists()
            and any(split_dir.glob("*.ogg"))
            and split_meta.is_file()
            and _split_meta_matches(
                split_meta,
                size_mb=args.size_mb,
                overlap=args.overlap,
                max_seconds=_effective_max_seconds(args),
            )
        )
        if split_cached:
            chunk_files = sorted(split_dir.glob("*.ogg"), key=numeric_sort_key)
            logger.info(f"[4/5] Split: cached ({len(chunk_files)} chunks)")
        else:
            if split_dir.exists() and any(split_dir.glob("*.ogg")):
                logger.info("[4/5] Split: params changed, re-splitting...")
                for stale in split_dir.glob("*.ogg"):
                    stale.unlink()
            else:
                logger.info("[4/5] Splitting by size...")
            split_args = [
                "-i",
                str(conv_out),
                "-o",
                str(split_dir),
                "--size-mb",
                str(args.size_mb),
                "--overlap",
                str(args.overlap),
            ]
            if args.engine == "local":
                try:
                    cap = model_audio_window_seconds(resolve_model(args.model))
                except Exception as e:
                    cap = None
                    logger.debug(f"Could not determine model audio window: {e}")
                if cap is not None:
                    split_args += ["--max-seconds", str(cap)]
            split_args += ["-v" * args.v]
            result = run_script(
                "audio-split",
                split_args,
                logger,
                args.threads,
            )
            if result.returncode != 0:
                logger.error(f"split failed: {result.stderr}")
                return 1

            chunk_files = [Path(p) for p in result.stdout.strip().split("\n") if p]
            logger.info(f"  -> Created {len(chunk_files)} chunks in {split_dir}")

        # Stage 5: Transcribe
        transcription_path = output_dir / "transcription.srt"
        speakers_path = transcription_path.with_suffix(".speakers.json")
        diarize_done = False
        if args.diarize and speakers_path.exists():
            result = load_speaker_mapping(speakers_path)
            if result is not None:
                _, diarize_done = result

        if transcription_path.exists() and not (args.force or (args.diarize and not diarize_done)):
            logger.info(f"[5/5] Transcribe: cached ({transcription_path.name})")
        else:
            logger.info("[5/5] Transcribing...")

            if args.engine == "local":
                local_args = [
                    "-i",
                    str(split_dir),
                    "-o",
                    str(transcription_path),
                    "-v" * args.v,
                ]
                if args.model:
                    local_args.extend(["--model", args.model])
                if args.language:
                    local_args.extend(["--language", args.language])
                if args.diarize:
                    local_args.append("--diarize")
                if args.num_speakers is not None:
                    local_args.extend(["--num-speakers", str(args.num_speakers)])
                result = run_script("audio-transcribe-local", local_args, logger)
            else:
                trans_args = [
                    "-i",
                    str(split_dir),
                    "-o",
                    str(transcription_path),
                    "-v" * args.v,
                ]
                if args.model:
                    trans_args.extend(["--model", args.model])
                if args.language:
                    trans_args.extend(["--language", args.language])
                result = run_script("audio-transcribe", trans_args, logger)

            if result.returncode != 0:
                logger.error("transcribe failed (see log above)")
                return 1
            logger.info(f"  -> {transcription_path}")

        logger.info("=" * 50)
        logger.info("Pipeline complete!")
        logger.info(f"  Output: {output_dir}")
        logger.info(f"  Chunks: {len(chunk_files)}")
        logger.info(f"  Transcript: {transcription_path}")

        return 0

    except Exception as e:
        logger.error(f"Error: {e}")
        return 1

    finally:
        # Clean intermediates only if --clean-temp, even on error/kill
        if args.clean_temp:
            import shutil

            shutil.rmtree(inter_dir, ignore_errors=True)
            logger.info("  Cleaned intermediates")


if __name__ == "__main__":
    sys.exit(main())
