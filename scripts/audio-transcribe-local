#!/usr/bin/env python3
"""Transcribe audio files locally using transcribe.cpp (Handy Computer's ggml STT engine).

transcribe.cpp is the new Handy Computer release that replaces the previous
ONNX transcription path. It runs GGUF models on Metal/Vulkan/CUDA/CPU and is
substantially faster than ONNX on the same hardware.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))

from dotenv import load_dotenv

from src.local_transcribe import discover_models, transcribe_local
from src.logging import add_verbose_arg, setup_logging
from src.srt import parse_srt, segments_to_srt

load_dotenv()

AUDIO_EXTENSIONS = [".ogg", ".opus", ".wav", ".m4a", ".mp3", ".flac", ".webm"]


def _correct_srt_offsets_for_opus_preskip(segments: list[dict], sidecar: Path) -> list[dict]:
    """Shift cached-SRT segment times back onto the continuous-WAV timeline.

    Older/cached SRTs were written with chunk offsets summed from each Opus
    chunk's ffprobe duration, which includes the per-chunk 312-sample pre-skip.
    The continuous diarize WAV decodes the single source stream once, so it
    steps by the true source length and every chunk k is offset forward by
    k * pre_skip. Re-derive that drift from the split sidecar and subtract it
    so the displayed and played timestamp matches the WAV position. Returns the
    segments unchanged if the sidecar is missing or the params can't be read.
    """
    if not sidecar.is_file():
        return segments
    try:
        import json

        meta = json.loads(sidecar.read_text(encoding="utf-8"))
        size_mb = float(meta["size_mb"])
        bitrate = int(meta["bitrate"])
        max_seconds = meta.get("max_seconds")
        overlap = float(meta.get("overlap", 0))
    except (KeyError, ValueError, json.JSONDecodeError):
        return segments

    chunk_s = int(size_mb * 1024 * 1024 * 8 / bitrate)
    if max_seconds is not None:
        chunk_s = int(min(chunk_s, float(max_seconds)))
    nominal_step = max(0.0, chunk_s - overlap)
    if nominal_step <= 0:
        return segments

    # Measure the real per-chunk pre-skip from one chunk if available.
    preskip_s = 0.0
    chunk_dir = sidecar.parent
    first_chunk = next(
        (p for p in sorted(chunk_dir.glob("*.ogg")) if p.is_file()), None
    )
    if first_chunk is not None:
        from src.audio import get_audio_duration

        try:
            real_dur = get_audio_duration(first_chunk)
            preskip_s = max(0.0, real_dur - chunk_s)
        except Exception:
            preskip_s = 0.0
    if preskip_s <= 0:
        return segments

    # Inflated step = nominal step + the per-chunk pre-skip the old math summed.
    step_inflated = nominal_step + preskip_s
    for seg in segments:
        k = int(seg.get("start", 0.0) / step_inflated)
        corr = k * preskip_s
        seg["start"] = max(0.0, seg["start"] - corr)
        seg["end"] = max(seg["start"], seg["end"] - corr)
    return segments


def _find_full_audio(input_path: Path) -> Path:
    """Auto-detect the full continuous audio file for diarization.

    If input is a file, use it directly.
    If input is a chunks dir, look in parent for processed.{ext}.
    """
    if input_path.is_file():
        return input_path

    parent = input_path.parent
    for ext in AUDIO_EXTENSIONS:
        candidate = parent / f"processed{ext}"
        if candidate.exists():
            return candidate

    raise FileNotFoundError(
        f"Could not find full audio file for diarization. "
        f"Expected processed.{{{'|'.join(AUDIO_EXTENSIONS)}}} in {parent}."
    )


def main() -> int:
    import argparse

    parser = argparse.ArgumentParser(
        description="Transcribe audio locally using transcribe.cpp (Handy Computer ggml STT)"
    )
    add_verbose_arg(parser)
    parser.add_argument(
        "--list-models",
        action="store_true",
        help="List available handy-computer GGUF models and exit",
    )
    pre, _ = parser.parse_known_args()
    list_only = getattr(pre, "list_models", False)

    parser.add_argument(
        "-i",
        "--input",
        type=Path,
        required=not list_only,
        help="Input audio file or directory of chunks",
    )
    parser.add_argument(
        "-o", "--output", type=Path, required=not list_only, help="Output .srt file"
    )
    parser.add_argument(
        "-m",
        "--model",
        help="GGUF model path or HF cache short name. Required (no default model).",
    )
    parser.add_argument(
        "-l",
        "--language",
        help="ISO 639-1 two-letter code (e.g., en, pt). Regional variants like pt-BR are not accepted; use the base code. None = auto-detect.",
    )
    parser.add_argument(
        "--overlap-secs",
        type=float,
        default=2.0,
        help=(
            "Overlap seconds used when splitting (default: 2). Lower overlap "
            "duplicates less audio per boundary, reducing transcription cost; "
            "2s preserves word boundaries for 15-65s model windows."
        ),
    )
    parser.add_argument(
        "-j",
        "--parallel",
        type=int,
        default=4,
        help="Parallel workers for chunk directory (default: 4)",
    )
    parser.add_argument(
        "--diarize", action="store_true", help="Run speaker diarization and label speakers"
    )
    parser.add_argument(
        "--num-speakers", type=int, default=None, help="Known number of speakers (optional)"
    )
    parser.add_argument(
        "--speakers-file",
        type=Path,
        default=None,
        help="Path to .speakers.json mapping (skip interactive prompt)",
    )
    args = parser.parse_args()
    logger = setup_logging(args.v)

    if args.list_models:
        models = discover_models()
        if not models:
            logger.error(
                "No GGUF models found in HuggingFace cache "
                "(~/.cache/huggingface/hub/models--handy-computer--*-gguf)."
            )
            return 1
        print("Available handy-computer GGUF models:")
        for m in models:
            print(f"  {m['name']:30s}  {m['quant']:8s}  {m['size_mb']:.0f} MB")
        return 0

    try:
        if args.output.exists() and args.output.stat().st_size > 0:
            logger.info(f"Loading existing transcription: {args.output}")
            segments = parse_srt(args.output.read_text(encoding="utf-8"))
            # Re-align cached segment times to the continuous-WAV timeline if a
            # split sidecar is present (corrects Opus pre-skip drift baked into
            # SRTs written before the offset fix).
            if args.input.is_dir():
                sidecar = args.input / ".split-meta.json"
            else:
                sidecar = args.input.parent / "chunks" / ".split-meta.json"
            segments = _correct_srt_offsets_for_opus_preskip(segments, sidecar)
            logger.info(f"Loaded {len(segments)} segments from SRT")
        else:
            segments = transcribe_local(
                input_path=args.input,
                model_query=args.model,
                language=args.language,
                overlap_secs=args.overlap_secs,
                parallel=args.parallel,
                logger=logger,
            )

        include_speakers = False

        if args.diarize:
            import json
            import sys as _sys

            from src.diarize import (
                _ensure_wav,
                apply_speaker_labels,
                assign_speakers_to_segments,
                diarize_audio,
                get_speaker_samples,
                load_speaker_mapping,
                prompt_speaker_labels,
                save_speaker_mapping,
            )

            speaker_labels = None
            speaker_finalized = False

            if args.speakers_file and args.speakers_file.exists():
                result = load_speaker_mapping(args.speakers_file)
                if result is not None:
                    speaker_labels, speaker_finalized = result
                    logger.info(f"Loaded speaker mapping from {args.speakers_file}")

            if speaker_labels is None:
                default_sp_path = args.output.with_suffix(".speakers.json")
                result = load_speaker_mapping(default_sp_path)
                if result is not None:
                    speaker_labels, speaker_finalized = result
                    logger.info(f"Loaded speaker mapping from {default_sp_path}")

            # Load cached diarization if available, otherwise run it
            diar_cache_path = args.output.with_suffix(".diarization.json")
            if diar_cache_path.exists():
                logger.info(f"Loading cached diarization: {diar_cache_path}")
                diarization_segments = json.loads(diar_cache_path.read_text(encoding="utf-8"))
                logger.info(f"Loaded {len(diarization_segments)} diarization segments")
            else:
                diarization_segments = diarize_audio(
                    audio_path=_find_full_audio(args.input),
                    num_speakers=args.num_speakers,
                    cache_dir=args.output.parent,
                    logger=logger,
                )
                diar_cache_path.write_text(
                    json.dumps(diarization_segments, indent=2), encoding="utf-8"
                )
                logger.info(f"Saved diarization cache to {diar_cache_path}")

            # Always assign speakers to segments (needed for labeling)
            segments = assign_speakers_to_segments(segments, diarization_segments)

            if speaker_finalized:
                logger.info("Using finalized speaker labels (skipping prompt)")
            elif _sys.stdin.isatty():
                # Prompt for speaker labels (shows saved labels as defaults)
                samples, _ = get_speaker_samples(segments)
                # Locate the cached diarize WAV for audio playback (or skip if unavailable).
                full_audio = _find_full_audio(args.input)
                _, wav_path = _ensure_wav(full_audio, cache_dir=args.output.parent)
                speaker_labels, speaker_finalized = prompt_speaker_labels(
                    samples, diarization_segments, wav_path=wav_path, existing_labels=speaker_labels
                )
            else:
                logger.warning(
                    "Not a TTY; skipping interactive speaker labeling. "
                    "Segments keep default SPEAKER_N labels (re-run in a terminal to name them)."
                )

            sp_path = args.output.with_suffix(".speakers.json")
            save_speaker_mapping(speaker_labels or {}, sp_path, finalized=speaker_finalized)
            logger.info(f"Saved speaker mapping to {sp_path}")

            segments = apply_speaker_labels(segments, speaker_labels or {})
            include_speakers = True
            srt_content = segments_to_srt(segments, include_speakers=include_speakers)

        srt_content = segments_to_srt(segments, include_speakers=include_speakers)

        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(srt_content, encoding="utf-8")

        print(str(args.output))
        return 0

    except Exception as e:
        logger.error(f"Error: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
